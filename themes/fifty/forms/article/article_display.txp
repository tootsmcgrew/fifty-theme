<!-- ===================================================================
   1. SINGLE ARTICLE VIEW (Permalinks - Includes Comments)
   =================================================================== -->
<txp:if_individual_article>
    <article class="single-entry type-<txp:section />">
        <header class="entry-header">
            <!-- Cover Image (Reading section) -->
            <txp:if_article_image>
                <div class="book-cover-wrapper">
                    <txp:article_image class="book-cover" />
                </div>
            </txp:if_article_image>

            <h1 itemprop="headline"><txp:title /></h1>

            <!-- Article Metadata -->
            <p class="entry-meta">
                <txp:if_custom_field name="text_author">
                    <span class="author">By <txp:custom_field name="text_author" /></span>
                </txp:if_custom_field>
                
                <txp:if_custom_field name="external_url">
                    <span class="meta-divider">|</span>
                    <a href="<txp:custom_field name="external_url" />" class="external-link" target="_blank" rel="noopener">
                        Visit Link ↗
                    </a>
                </txp:if_custom_field>

                <txp:if_article_category number="1">
                    <span class="meta-divider">|</span>
                    <span class="category-tag"><txp:category1 title="1" /></span>
                </txp:if_article_category>

                <txp:if_article_category number="2">
                    <span class="meta-divider">|</span>
                    <span class="category-tag"><txp:category2 title="1" /></span>
                </txp:if_article_category>
                
                <span class="meta-divider">|</span>
                <time datetime="<txp:posted format='iso8601' />"><txp:posted format="%B %d, %Y" /></time>
            </p>
        </header>

        <!-- Optional Excerpt / Dek -->
        <txp:if_excerpt>
            <div class="entry-dek">
                <txp:excerpt />
            </div>
        </txp:if_excerpt>

        <!-- Article Body -->
        <div itemprop="articleBody" class="entry-content">
            <txp:body />
        </div>

        <!-- Comments Section -->
        <txp:output_form form="comments_display" />

    </article>

<txp:else />

<!-- ===================================================================
   2. LIST VIEW: OPENING WRAPPERS
   =================================================================== -->
<txp:if_first_article>
    <txp:if_section name="articles">
        <div class="writing-accordion-group">
    </txp:if_section>

    <txp:if_section name="reading">
        <div class="reading-accordion-group">
    </txp:if_section>

    <txp:if_section name="links">
        <div class="links-grid">
    </txp:if_section>
</txp:if_first_article>

<!-- ===================================================================
   3. LIST VIEW: SECTION-SPECIFIC ITEMS (FLAT LOGIC)
   =================================================================== -->

    <!-- Branch A: Articles (Categorized Accordion) -->
    <txp:if_section name="articles">
        <txp:if_different test='<txp:category1 />'>
            <txp:if_first_article><txp:else />
                </ul>
                </details>
            </txp:if_first_article>

            <details class="category-accordion" open>
                <summary class="category-heading">
                    <txp:category1 title="1" default="Essays & Uncategorized" />
                </summary>
                <ul class="category-list">
        </txp:if_different>

        <li class="article-entry">
            <a href="<txp:permlink />"><txp:title /></a> 
            <span class="meta-divider">—</span> 
            <time datetime="<txp:posted format='iso8601' />"><txp:posted format="%b %d, %Y" /></time>
        </li>
    </txp:if_section>

    <!-- Branch B: Reading Log (Categorized by Medium with Excerpts) -->
    <txp:if_section name="reading">
        <txp:if_different test='<txp:category1 />'>
            <txp:if_first_article><txp:else />
                </ul>
                </details>
            </txp:if_first_article>

            <details class="reading-medium-accordion" open>
                <summary class="category-heading">
                    <txp:category1 title="1" default="General Reading" />
                </summary>
                <ul class="reading-list">
        </txp:if_different>

        <li class="reading-entry">
            <div class="reading-entry-header">
                <a href="<txp:permlink />" class="book-title"><txp:title /></a>
                
                <txp:if_custom_field name="text_author">
                    <span class="author-byline">by <txp:custom_field name="text_author" /></span>
                </txp:if_custom_field>

                <txp:if_article_category number="2">
                    <span class="pub-byline">(<txp:category2 title="1" />)</span>
                </txp:if_article_category>

                <span class="meta-divider">—</span> 
                <time datetime="<txp:posted format='iso8601' />"><txp:posted format="%b %Y" /></time>
            </div>

            <txp:if_excerpt>
                <div class="reading-entry-excerpt">
                    <txp:excerpt />
                </div>
            </txp:if_excerpt>
        </li>
    </txp:if_section>

    <!-- Branch C: Notes (Stream Cards) -->
    <txp:if_section name="notes">
        <article class="note">
            <div class="note-content">
                <txp:body />
            </div>
            <p class="meta">
                <a href="<txp:permlink />"><time datetime="<txp:posted format="c" />"><txp:posted format="%b %d, %Y %I:%M %p" /></time></a>
                <txp:if_comments>
                    <span class="note-comments-count">
                        — <a href="<txp:permlink />#comments" title="View comments">
                            <txp:comments_count /> comment<txp:evaluate test="comments_count > 1">s</txp:evaluate>
                        </a>
                    </span>
                </txp:if_comments>
            </p>
        </article>
    </txp:if_section>

    <!-- Branch D: Dedicated Links Cards (Grid Layout) -->
    <txp:if_section name="links">
        <article class="link-card">
            <header class="link-card-header">
                <h3 class="link-title">
                    <txp:if_custom_field name="external_url">
                        <a href="<txp:custom_field name="external_url" />" class="external-link" rel="noopener" target="_blank">
                            <txp:title /> <span class="external-icon" aria-hidden="true">↗</span>
                        </a>
                    <txp:else />
                        <a href="<txp:permlink />"><txp:title /></a>
                    </txp:if_custom_field>
                </h3>

                <txp:if_custom_field name="text_author">
                    <p class="link-author">by <txp:custom_field name="text_author" /></p>
                </txp:if_custom_field>
                
                <txp:if_article_category number="1">
                    <div class="link-categories">
                        <span class="link-badge category-1"><txp:category1 title="1" /></span>
                        <txp:if_article_category number="2">
                            <span class="link-badge category-2"><txp:category2 title="1" /></span>
                        </txp:if_article_category>
                    </div>
                </txp:if_article_category>
            </header>

            <txp:if_excerpt>
                <div class="link-excerpt">
                    <txp:excerpt />
                </div>
            </txp:if_excerpt>

            <footer class="link-card-footer">
                <time datetime="<txp:posted format='iso8601' />"><txp:posted format="%b %d, %Y" /></time>
                <txp:if_custom_field name="external_url">
                    <span class="meta-divider">•</span>
                    <a href="<txp:permlink />" class="permalink-note">Permalink</a>
                </txp:if_custom_field>
            </footer>
        </article>
    </txp:if_section>

    <!-- Branch E: Fallback for Daily, White Papers, Default Section -->
    <txp:if_section name="articles, reading, notes, links"><txp:else />
        <article class="article-entry">
            <h3><a href="<txp:permlink />"><txp:title /></a></h3>
            <txp:if_excerpt><txp:excerpt /><txp:else /><time datetime="<txp:posted format='iso8601' />"><txp:posted format="%b %d, %Y" /></time></txp:if_excerpt>
        </article>
    </txp:if_section>

<!-- ===================================================================
   4. LIST VIEW: CLOSING WRAPPERS
   =================================================================== -->
<txp:if_last_article>
    <txp:if_section name="articles, reading">
            </ul>
        </details>
        </div>
    </txp:if_section>

    <txp:if_section name="links">
        </div>
    </txp:if_section>
</txp:if_last_article>

</txp:if_individual_article>