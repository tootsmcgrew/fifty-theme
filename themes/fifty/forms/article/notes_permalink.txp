<article class="note single-entry type-notes" itemscope itemtype="https://schema.org/SocialMediaPosting">
    <header class="entry-header">
        <h1 class="entry-title" itemprop="headline">
            <txp:posted format="%B %d, %Y" /> at <txp:posted format="%I:%M %p" />
        </h1>
    </header>

    <div class="note-content" itemprop="sharedContent">
        <txp:body />
    </div>

    <txp:if_article_category>
        <p class="meta">
            Categories:
            <txp:category1 title="1" link="1" />
            <txp:if_article_category number="2">
                , <txp:category2 title="1" link="1" />
            </txp:if_article_category>
        </p>
    </txp:if_article_category>
</article>