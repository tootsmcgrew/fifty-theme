<txp:if_section name="reading, notes, links, articles">
    <!-- Automatically loads reading_permalink, notes_permalink, etc. -->
    <txp:output_form form='<txp:section />_permalink' />
<txp:else />
    <!-- The fallback for any brand-new section you create later -->
    <article class="single-<txp:section />" itemscope itemtype="https://schema.org/BlogPosting">
        <h1 itemprop="headline"><txp:title /></h1>
        <div itemprop="articleBody"><txp:body /></div>
    </article>
</txp:if_section>