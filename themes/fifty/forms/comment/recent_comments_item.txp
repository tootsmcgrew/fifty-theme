<li class="recent-comment-item">
  <span class="recent-comment-author"><txp:comment_name /></span>
  <span class="recent-comment-meta">
    on <txp:comment_permlink><txp:title /></txp:comment_permlink>
  </span>
  <blockquote class="recent-comment-excerpt">
    <txp:comment_message />
  </blockquote>
  <time class="recent-comment-date" datetime="<txp:comment_time format="iso8601" />">
    <txp:comment_time format="%b %d, %Y" />
  </time>
</li>