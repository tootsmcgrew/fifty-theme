<txp:variable name="this_comment" value='<txp:comment_email />' />
<txp:if_variable name="this_comment" value='<txp:author_email />'>
    <article class="comments comments-author" id="c<txp:comment_id />" itemscope itemtype="https://schema.org/Comment">
<txp:else />
    <article class="comments" id="c<txp:comment_id />" itemscope itemtype="https://schema.org/Comment">
</txp:if_variable>

    <h4>
        <span class="comment-author" itemprop="author" itemscope itemtype="https://schema.org/Person">
            <span itemprop="name">
                <txp:comment_name />
            </span>
        </span>

        <txp:if_variable name="this_comment" value='<txp:author_email />'>
            <span class="is-author">
                (<txp:text item="author" />)
            </span>
        </txp:if_variable>

        <span class="comment-anchor" itemprop="url">
            <txp:comment_permlink>#</txp:comment_permlink>
        </span>
    </h4>

    <p class="footnote">
        <time datetime="<txp:comment_time format="iso8601" />" itemprop="dateCreated">
            <txp:comment_time />
            (<txp:comment_time format="since" />)
        </time>
    </p>

    <div class="comment-message" itemprop="text">
        <txp:comment_message />
    </div>

    <p class="comment-actions">
        <button type="button" class="btn-quote" data-comment-id="<txp:comment_id />">
            Quote &amp; Reply
        </button>
    </p>
</article>