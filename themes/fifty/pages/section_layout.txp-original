<txp:output_form form="html_head" />
<body class="<txp:if_individual_article>permalink-page <txp:if_article_category number="1">category-<txp:category1 title="0" /></txp:if_article_category><txp:if_article_category number="2"> category-<txp:category2 title="0" /></txp:if_article_category><txp:else />listing-page</txp:if_individual_article> section-<txp:section />" itemscope itemtype="https://schema.org/CollectionPage">

    <!-- THE HEADER SWITCH -->
    <txp:if_individual_article>
        <txp:output_form form="site_mini_header" />
    <txp:else />
        <txp:output_form form="site_header" />
    </txp:if_individual_article>

    <div class="wrapper">
        <!-- Add a modifier class when on the notes section -->
        <div class="container <txp:if_section name="notes"><txp:if_individual_article><txp:else />has-sidebar</txp:if_individual_article></txp:if_section>">

            <!-- SIDEBAR ARCHIVE (Only on Notes list view) -->
            <txp:if_section name="notes">
                <txp:if_individual_article><txp:else />
                    <aside class="sidebar">
                        <nav class="archive-nav" aria-label="Notes archive">
                            <h3>Notes Archive</h3>
                            
                            <txp:variable name="close_details" value="" />
                            
                            <txp:article_custom section="notes" sort="Posted desc" limit="9999" wraptag="" break="">
                                <txp:if_different test='<txp:posted format="%Y" />'>
                                    <txp:if_variable name="close_details" value="yes">
                                        </ul></details>
                                    </txp:if_variable>
                                    
                                    <details class="archive-year">
                                        <summary><txp:posted format="%Y" /></summary>
                                        <ul class="archive-months">
                                    
                                    <txp:variable name="close_details" value="yes" />
                                </txp:if_different>
                                
                                <txp:if_different test='<txp:posted format="%Y-%m" />'>
                                    <li class="archive-month">
                                        <a href="<txp:section url="1" />?month=<txp:posted format="%Y-%m" />"><txp:posted format="%B" /></a>
                                    </li>
                                </txp:if_different>
                                
                                <txp:if_last_article>
                                    </ul></details>
                                </txp:if_last_article>
                            </txp:article_custom>
                        </nav>
                    </aside>
                </txp:if_individual_article>
            </txp:if_section>

            <main id="main" aria-label="<txp:text item="main_content" />">
            
                <!-- Pass 'article_display' as BOTH form and listform -->
                <txp:if_section name="articles, reading">
                    <txp:article sort="Category1 asc, Posted desc" form="article_display" listform="article_display" limit="999" />
                <txp:else />
                    <txp:article form="article_display" listform="article_display" />
                </txp:if_section>
            
                <!-- Pagination (Only on list views) -->
                <txp:if_individual_article><txp:else />
                    <txp:evaluate test="newer,older">
                        <nav class="paginator" aria-label="<txp:text item='page_nav' />">
                            <txp:newer rel="prev"><txp:text item="newer" /></txp:newer>
                            <txp:older rel="next"><txp:text item="older" /></txp:older>
                        </nav>
                    </txp:evaluate>
                </txp:if_individual_article>
            
            </main>

        </div>
    </div>

    <txp:output_form form="site_footer" />

    <txp:if_variable name="load_infinite_scroll" value="true">
        <script src="/assets/js/infinite-scroll.js" defer></script>
    </txp:if_variable>
</body>
</html>